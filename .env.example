# ==============================================================================
# Docx-Agent V2.1 Configuration Environment File
# ==============================================================================

# Application Environment (development, testing, production)
DOCX_AGENT_ENV=development

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DOCX_AGENT_LOG_LEVEL=INFO
DOCX_AGENT_STRUCTURED_LOGS=true

# Workspace Server Settings
DOCX_AGENT_WORKSPACE_PORT=8765
DOCX_AGENT_WORKSPACE_HOST=127.0.0.1
DOCX_AGENT_AUTO_OPEN_BROWSER=true

# Model & Engine Limits
DOCX_AGENT_MAX_FILE_SIZE_MB=50
DOCX_AGENT_PAGINATION_DPI=96
DOCX_AGENT_AUTO_BACKUP=true

# Research & External Verification API (Optional)
# DOCX_AGENT_CROSSREF_MAILTO=maintainer@example.com
# DOCX_AGENT_ARXIV_API_URL=https://export.arxiv.org/api/query
