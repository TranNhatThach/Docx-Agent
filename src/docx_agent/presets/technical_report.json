{
  "name": "technical-report",
  "description": "Clean Modern Technical Report Format with Arial / Inter Typography",
  "page_size": "a4",
  "orientation": "portrait",
  "margins": {
    "top_cm": 2.5,
    "bottom_cm": 2.5,
    "left_cm": 2.5,
    "right_cm": 2.5
  },
  "styles": {
    "Normal": {
      "font": {
        "name": "Calibri",
        "size_pt": 11.0
      },
      "paragraph_format": {
        "alignment": "left",
        "line_spacing": 1.15,
        "space_before_pt": 0.0,
        "space_after_pt": 6.0,
        "first_line_indent_cm": 0.0
      }
    },
    "Heading 1": {
      "font": {
        "name": "Calibri",
        "size_pt": 16.0,
        "bold": true,
        "color_rgb": "003366"
      },
      "paragraph_format": {
        "alignment": "left",
        "line_spacing": 1.15,
        "space_before_pt": 12.0,
        "space_after_pt": 6.0,
        "keep_with_next": true
      }
    },
    "Heading 2": {
      "font": {
        "name": "Calibri",
        "size_pt": 13.0,
        "bold": true,
        "color_rgb": "336699"
      },
      "paragraph_format": {
        "alignment": "left",
        "line_spacing": 1.15,
        "space_before_pt": 8.0,
        "space_after_pt": 4.0,
        "keep_with_next": true
      }
    }
  }
}
