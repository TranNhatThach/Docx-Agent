{
  "name": "academic-vn",
  "description": "Tiêu chuẩn định dạng luận văn, đồ án tốt nghiệp, báo cáo học thuật Việt Nam",
  "page_size": "a4",
  "orientation": "portrait",
  "margins": {
    "top_cm": 2.0,
    "bottom_cm": 2.0,
    "left_cm": 3.0,
    "right_cm": 2.0
  },
  "styles": {
    "Normal": {
      "font": {
        "name": "Times New Roman",
        "size_pt": 13.0
      },
      "paragraph_format": {
        "alignment": "justify",
        "line_spacing": 1.5,
        "space_before_pt": 0.0,
        "space_after_pt": 6.0,
        "first_line_indent_cm": 1.27
      }
    },
    "Heading 1": {
      "font": {
        "name": "Times New Roman",
        "size_pt": 16.0,
        "bold": true
      },
      "paragraph_format": {
        "alignment": "left",
        "line_spacing": 1.5,
        "space_before_pt": 12.0,
        "space_after_pt": 6.0,
        "first_line_indent_cm": 0.0,
        "keep_with_next": true
      }
    },
    "Heading 2": {
      "font": {
        "name": "Times New Roman",
        "size_pt": 14.0,
        "bold": true
      },
      "paragraph_format": {
        "alignment": "left",
        "line_spacing": 1.5,
        "space_before_pt": 6.0,
        "space_after_pt": 6.0,
        "first_line_indent_cm": 0.0,
        "keep_with_next": true
      }
    },
    "Heading 3": {
      "font": {
        "name": "Times New Roman",
        "size_pt": 13.0,
        "bold": true,
        "italic": true
      },
      "paragraph_format": {
        "alignment": "left",
        "line_spacing": 1.5,
        "space_before_pt": 6.0,
        "space_after_pt": 3.0,
        "first_line_indent_cm": 0.0,
        "keep_with_next": true
      }
    }
  },
  "footer": {
    "page_numbers": true,
    "format": "Trang {PAGE} / {NUMPAGES}",
    "alignment": "center"
  }
}
