{
  "name": "apa",
  "description": "American Psychological Association (APA 7th Edition) Paper Format",
  "page_size": "letter",
  "orientation": "portrait",
  "margins": {
    "top_cm": 2.54,
    "bottom_cm": 2.54,
    "left_cm": 2.54,
    "right_cm": 2.54
  },
  "styles": {
    "Normal": {
      "font": {
        "name": "Times New Roman",
        "size_pt": 12.0
      },
      "paragraph_format": {
        "alignment": "left",
        "line_spacing": 2.0,
        "space_before_pt": 0.0,
        "space_after_pt": 0.0,
        "first_line_indent_cm": 1.27
      }
    },
    "Heading 1": {
      "font": {
        "name": "Times New Roman",
        "size_pt": 12.0,
        "bold": true
      },
      "paragraph_format": {
        "alignment": "center",
        "line_spacing": 2.0,
        "space_before_pt": 12.0,
        "space_after_pt": 6.0,
        "keep_with_next": true
      }
    }
  }
}
