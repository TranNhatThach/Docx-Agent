{
  "name": "ieee",
  "description": "IEEE Conference and Transactions Standard Formatting",
  "page_size": "letter",
  "orientation": "portrait",
  "margins": {
    "top_cm": 1.9,
    "bottom_cm": 1.9,
    "left_cm": 1.9,
    "right_cm": 1.9
  },
  "styles": {
    "Normal": {
      "font": {
        "name": "Times New Roman",
        "size_pt": 10.0
      },
      "paragraph_format": {
        "alignment": "justify",
        "line_spacing": 1.0,
        "space_before_pt": 0.0,
        "space_after_pt": 4.0,
        "first_line_indent_cm": 0.63
      }
    },
    "Heading 1": {
      "font": {
        "name": "Times New Roman",
        "size_pt": 11.0,
        "bold": true
      },
      "paragraph_format": {
        "alignment": "center",
        "line_spacing": 1.0,
        "space_before_pt": 8.0,
        "space_after_pt": 4.0,
        "keep_with_next": true
      }
    }
  }
}
